DISABLE_HMR=

APP_ID=
CLIENT_ID=
CHANNEL_ID=
CLIENT_SECRET=
SLACK_SIGNING_SECRET=
VERIFICATION_TOKEN=
OAUTH_TOKEN=
USER_OAUTH_TOKEN=
BOT_USER_OAUTH_TOKEN=
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Optional authoring: Supabase or other Postgres (local only; never commit real values).
# Use `.env.local` in the repo root. Local scripts load it before reading source snapshots.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # server-side export scripts only; do not expose to the browser
# SUPABASE_ANON_KEY=           # if you add a future client-only flow
# Optional: override dataset CDN/base URL for the SPA (must serve manifest.json + JSON siblings).
# VITE_DATASET_BASE_URL=https://example.com/my-dataset-bundle

# Optional: Postgres URL for `npm run supabase:phase1-csv-pipeline -- export`
# (Supabase direct or pooler; never commit real credentials).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
